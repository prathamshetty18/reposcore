{
  "name": "reposcore",
  "version": "1.0.0",
  "description": "Judge a public GitHub repo against hackathon criteria using deterministic rules plus optional AI",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathamshetty18/reposcore.git"
  },
  "keywords": ["hackathon", "ai", "github", "open-source"],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/prathamshetty18/reposcore/issues"
  },
  "homepage": "https://github.com/prathamshetty18/reposcore#readme",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}