# GitHub Personal Access Token (for reading public repos and higher API rate limits)
GITHUB_TOKEN=

# ==============================================================================
# AI Provider Configuration (Optional — default mode is Rules Only, no AI needed)
# ==============================================================================
# Supported presets: groq | openrouter | ollama | custom
AI_PROVIDER=groq

# Base URL (optional if using presets, or set explicitly)
# Presets:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Model ID
# Examples:
#   Groq:       openai/gpt-oss-120b (or qwen/qwen3.8-27b)
#   OpenRouter: meta-llama/llama-3.3-70b-instruct:free
#   Ollama:     llama3
AI_MODEL=openai/gpt-oss-120b

# AI API Key (not required for Ollama or local endpoints)
AI_API_KEY=

# Optional timeouts in milliseconds
JUDGE_TIMEOUT_MS=120000
