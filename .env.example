# GitHub Personal Access Token (for reading public repos and higher API rate limits)
GITHUB_TOKEN=

# ==============================================================================
# AI Provider Configuration (Optional — default mode is Rules Only, no AI needed)
# ==============================================================================
# Supported presets: groq | openrouter | ollama | custom
AI_PROVIDER=groq

# Base URL (optional if using presets, or set explicitly)
# Presets:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Model ID (default: llama-3.3-70b-versatile; or openai/gpt-oss-120b)
AI_MODEL=llama-3.3-70b-versatile

# Groq API Key
GROQ_API_KEY=
AI_API_KEY=

# Optional timeouts in milliseconds
JUDGE_TIMEOUT_MS=120000

# Rate limiting (per IP, default: 10 requests per hour; cache hits do not consume limit)
RATE_LIMIT_MAX=10
